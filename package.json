{
  "name": "nexus-knowledge-universe",
  "productName": "NEXUS",
  "version": "1.0.0",
  "description": "A cinematic, local-first knowledge universe for your Obsidian vault.",
  "main": "./out/main/index.js",
  "author": "Albert",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "test:packaged": "NEXUS_TEST_PACKAGED=1 playwright test",
    "icons": "node scripts/generate-icon.mjs",
    "demo-vault": "node scripts/generate-demo-vault.mjs",
    "pack": "npm run build && electron-builder --config electron-builder.config.cjs --mac dir --arm64",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --mac --arm64",
    "test:all": "npm run test && npm run test:e2e",
    "release:github": "node scripts/package-github.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chokidar": "^4.0.3",
    "d3-force-3d": "^3.0.6",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "motion": "^14.14.0",
    "pngjs": "^7.0.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
